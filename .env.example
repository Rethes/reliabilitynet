# Copy this file to .env and fill in your values.
# Never commit your real .env file to git.

# ── News API ──────────────────────────────────────────────────────────────────
# Get your key at https://freenewsapi.com
FREENEWS_API_KEY=

# ── API base URL ──────────────────────────────────────────────────────────────
# Local dev: leave empty → frontend uses the local proxy on port 3131
# Production build: set to your Cloudflare Worker URL
#   e.g. https://reliabilitynet-api-production.rethesmutua.workers.dev
VITE_API_BASE=

# ── ML backend override (optional) ───────────────────────────────────────────
# Leave empty to use the Worker relay (production) or localhost:5001 (local dev).
# Only set this if you want to point directly at an external ML server.
# Example: a running Kaggle+ngrok Flask tunnel (static domain, stays the same):
# VITE_ML_BASE=https://jockstrap-track-paradox.ngrok-free.dev
VITE_ML_BASE=